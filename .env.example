# Copy to .env.local for localhost and set the same names in Vercel project env.
# Do not put live secrets in this file.

# Public (browser bundle) — use Supabase "publishable" key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave unset so the browser calls same-origin /api
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_USE_REALTIME=

# Server-only — use Supabase "secret" key (sb_secret_…). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Transaction pooler, port 6543. Not the direct 5432 session URL.
DATABASE_URL=

# Required for presence heartbeats (HTTPS REST). Do not leave empty on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional alternate REST names (same values). Do not point these at a deleted DB.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL / KV_URL as rediss:// are TCP-only — ignored by @upstash/redis REST.

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minglecall-bucket
# Optional public CDN (custom domain or pub-*.r2.dev). Never *.r2.cloudflarestorage.com.
# Leave empty to proxy media through /api/storage/media?key=…
# R2_PUBLIC_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true
RESEND_API_KEY=

CRON_SECRET=
FINANCE_JOB_SECRET=
FINANCE_JOB_ACTOR_USER_ID=
FINANCE_WEBHOOK_SECRET=

SETUP_MASTER_KEY=
SETUP_LOCKED=true
ALLOW_FACTORY_RESET=false
