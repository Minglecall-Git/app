# Copy to .env.local for localhost and set the same names in Vercel project env.
# Do not put live secrets in this file.

# Public (browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional fallbacks still read by older client code
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave unset so the browser calls same-origin /api
# NEXT_PUBLIC_API_BASE_URL=
# VITE_API_BASE_URL=
# NEXT_PUBLIC_USE_REALTIME=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler, port 6543. Not the direct 5432 session URL.
DATABASE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV REST:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=true
RESEND_API_KEY=

CRON_SECRET=
FINANCE_JOB_SECRET=
FINANCE_JOB_ACTOR_USER_ID=
FINANCE_WEBHOOK_SECRET=

SETUP_MASTER_KEY=
SETUP_LOCKED=true
ALLOW_FACTORY_RESET=false
